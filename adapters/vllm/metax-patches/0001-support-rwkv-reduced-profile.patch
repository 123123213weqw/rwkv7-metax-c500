 # SPDX-License-Identifier: Apache-2.0
 # 2026 - Modified by MetaX Integrated Circuits (Shanghai) Co., Ltd. All Rights Reserved.
 
+import os
+
 from .version import __version__, __version_tuple__  # noqa: F401
 
 
+def _is_rwkv_reduced_build() -> bool:
+    from vllm.build_profile import get_build_profile_metadata
+
+    return get_build_profile_metadata().profile == "rwkv"
+
+
+def _install_torch_accelerator_compat() -> None:
+    import torch
+
+    aliases = {
+        "empty_cache": "empty_cache",
+        "get_memory_info": "mem_get_info",
+        "max_memory_allocated": "max_memory_allocated",
+        "memory_stats": "memory_stats",
+        "memory_reserved": "memory_reserved",
+        "memory_allocated": "memory_allocated",
+        "reset_peak_memory_stats": "reset_peak_memory_stats",
+    }
+    for accelerator_name, cuda_name in aliases.items():
+        if hasattr(torch.accelerator, accelerator_name):
+            continue
+        implementation = getattr(torch.cuda, cuda_name, None)
+        if implementation is not None:
+            setattr(torch.accelerator, accelerator_name, implementation)
+
+
+def _configure_rwkv_reduced_profile() -> None:
+    if _is_rwkv_reduced_build():
+        os.environ.setdefault("VLLM_RWKV7_DISABLE_CMIX_NOFC", "1")
+
+
 def collect_env() -> None:
     from vllm_metax.collect_env import main as collect_env_main
 
@@ -13,6 +46,8 @@ def collect_env() -> None:
 ########### platform plugin ###########
 def register():
     """Register the METAX platform."""
+    _configure_rwkv_reduced_profile()
+    _install_torch_accelerator_compat()
     return "vllm_metax.platform.MacaPlatform"
 
 
