+# SPDX-License-Identifier: Apache-2.0
+# 2026 - Modified by MetaX Integrated Circuits (Shanghai) Co., Ltd. All Rights Reserved.
+
+import vllm_metax
+
+
+def test_reduced_profile_disables_unvalidated_cmix_nofc(monkeypatch) -> None:
+    monkeypatch.delenv("VLLM_RWKV7_DISABLE_CMIX_NOFC", raising=False)
+    monkeypatch.setattr(vllm_metax, "_is_rwkv_reduced_build", lambda: True)
+
+    vllm_metax._configure_rwkv_reduced_profile()
+
+    assert vllm_metax.os.environ["VLLM_RWKV7_DISABLE_CMIX_NOFC"] == "1"
+
+
+def test_reduced_profile_preserves_explicit_cmix_nofc_override(monkeypatch) -> None:
+    monkeypatch.setenv("VLLM_RWKV7_DISABLE_CMIX_NOFC", "0")
+    monkeypatch.setattr(vllm_metax, "_is_rwkv_reduced_build", lambda: True)
+
+    vllm_metax._configure_rwkv_reduced_profile()
+
+    assert vllm_metax.os.environ["VLLM_RWKV7_DISABLE_CMIX_NOFC"] == "0"
