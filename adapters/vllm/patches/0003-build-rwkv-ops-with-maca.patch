diff --git a/csrc/rwkv7_maca/cuda_view.cu b/csrc/rwkv7_maca/cuda_view.cu
new file mode 100644
index 0000000..9b68c6a
--- /dev/null
+++ b/csrc/rwkv7_maca/cuda_view.cu
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include <torch/all.h>
+#include <torch/cuda.h>
+
+#include <cuda_runtime.h>
+
+torch::Tensor get_cuda_view_from_cpu_tensor(torch::Tensor& cpu_tensor) {
+  TORCH_CHECK(cpu_tensor.device().is_cpu(), "Input tensor must be on CPU");
+
+  if (cpu_tensor.numel() == 0) {
+    return torch::empty(cpu_tensor.sizes(),
+                        cpu_tensor.options().device(torch::kCUDA));
+  }
+
+  if (cpu_tensor.is_pinned()) {
+    void* host_ptr = const_cast<void*>(cpu_tensor.data_ptr());
+    void* device_ptr = nullptr;
+    cudaError_t error = cudaHostGetDevicePointer(&device_ptr, host_ptr, 0);
+    TORCH_CHECK(error == cudaSuccess, "cudaHostGetDevicePointer failed: ",
+                cudaGetErrorString(error));
+    return torch::from_blob(
+        device_ptr, cpu_tensor.sizes(), cpu_tensor.strides(),
+        [base = cpu_tensor](void*) {},
+        cpu_tensor.options().device(torch::kCUDA));
+  }
+
+  torch::Tensor contiguous_cpu = cpu_tensor.contiguous();
+  const size_t bytes = contiguous_cpu.nbytes();
+  void* host_ptr = nullptr;
+  cudaError_t error = cudaHostAlloc(&host_ptr, bytes, cudaHostAllocMapped);
+  TORCH_CHECK(error == cudaSuccess, "cudaHostAlloc failed: ",
+              cudaGetErrorString(error));
+
+  error = cudaMemcpy(host_ptr, contiguous_cpu.data_ptr(), bytes,
+                     cudaMemcpyDefault);
+  if (error != cudaSuccess) {
+    cudaFreeHost(host_ptr);
+    TORCH_CHECK(false, "cudaMemcpy failed: ", cudaGetErrorString(error));
+  }
+
+  void* device_ptr = nullptr;
+  error = cudaHostGetDevicePointer(&device_ptr, host_ptr, 0);
+  if (error != cudaSuccess) {
+    cudaFreeHost(host_ptr);
+    TORCH_CHECK(false, "cudaHostGetDevicePointer failed: ",
+                cudaGetErrorString(error));
+  }
+
+  return torch::from_blob(
+      device_ptr, contiguous_cpu.sizes(), contiguous_cpu.strides(),
+      [host_ptr](void*) { cudaFreeHost(host_ptr); },
+      contiguous_cpu.options().device(torch::kCUDA));
+}
diff --git a/csrc/rwkv7_maca/registration.cpp b/csrc/rwkv7_maca/registration.cpp
new file mode 100644
index 0000000..ebcd457
--- /dev/null
+++ b/csrc/rwkv7_maca/registration.cpp
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include "core/registration.h"
+
+#include <torch/all.h>
+#include <torch/library.h>
+
+torch::Tensor get_cuda_view_from_cpu_tensor(torch::Tensor& cpu_tensor);
+
+#ifdef VLLM_RWKV_RUNTIME_OPS
+TORCH_LIBRARY_FRAGMENT(_C, ops) {
+  ops.def("get_cuda_view_from_cpu_tensor(Tensor cpu_tensor) -> Tensor");
+}
+
+TORCH_LIBRARY_IMPL(_C, CPU, ops) {
+  ops.impl("get_cuda_view_from_cpu_tensor", &get_cuda_view_from_cpu_tensor);
+}
+#endif
+
+REGISTER_EXTENSION(TORCH_EXTENSION_NAME)
