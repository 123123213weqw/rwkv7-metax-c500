+def test_rwkv7_cmix_nofc_can_be_disabled(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("VLLM_RWKV7_DISABLE_CMIX_NOFC", "1")
+
+    assert rwkv7.select_path(1, 1).cmix_mode == rwkv7.CMIX_DENSE
+    assert rwkv7.select_path(2, 1).cmix_mode == rwkv7.CMIX_DENSE
+    assert rwkv7.select_path(19, 1).cmix_mode == rwkv7.CMIX_DENSE
+    assert rwkv7.select_path(4, 5).cmix_mode == rwkv7.CMIX_DENSE
+
+
+def test_rwkv7_cmix_nofc_remains_default(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("VLLM_RWKV7_DISABLE_CMIX_NOFC", raising=False)
+
+    assert rwkv7.select_path(1, 1).cmix_mode == rwkv7.CMIX_B1T1_NOFC
+    assert rwkv7.select_path(2, 1).cmix_mode == rwkv7.CMIX_ROWS2_NOFC
+
