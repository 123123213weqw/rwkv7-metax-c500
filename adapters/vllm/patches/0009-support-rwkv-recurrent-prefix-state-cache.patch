new file mode 100644
index 000000000..897592521
--- /dev/null
+++ b/vllm/v1/rwkv_state_prefix_cache.py
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import sys
+from array import array
+from collections import OrderedDict
+from collections.abc import Sequence
+from hashlib import sha256
+from struct import pack
+from typing import Any, Generic, TypeVar
+
+_CACHE_KEY_VERSION = b"vllm-rwkv7-state-prefix-v1\0"
+DEFAULT_RWKV_STATE_CACHE_BLOCK_SIZE = 64
+DEFAULT_RWKV_STATE_CACHE_CAPACITY = 8
+
+T = TypeVar("T")
+
+
+def get_rwkv_state_prefix_cache_config(
+    vllm_config: Any,
+) -> tuple[bool, int, int]:
+    additional_config = getattr(vllm_config, "additional_config", None)
+    if not isinstance(additional_config, dict):
+        return (
+            False,
+            DEFAULT_RWKV_STATE_CACHE_CAPACITY,
+            DEFAULT_RWKV_STATE_CACHE_BLOCK_SIZE,
+        )
+    return (
+        bool(additional_config.get("rwkv_state_prefix_cache", False)),
+        int(
+            additional_config.get(
+                "rwkv_state_prefix_cache_capacity",
+                DEFAULT_RWKV_STATE_CACHE_CAPACITY,
+            )
+        ),
+        int(
+            additional_config.get(
+                "rwkv_state_prefix_cache_block_size",
+                DEFAULT_RWKV_STATE_CACHE_BLOCK_SIZE,
+            )
+        ),
+    )
+
+
+def rwkv_state_prefix_key(token_ids: Sequence[int], num_tokens: int) -> bytes:
+    """Return a stable key for the first ``num_tokens`` prompt tokens."""
+    if num_tokens <= 0 or num_tokens > len(token_ids):
+        raise ValueError(
+            f"Invalid RWKV7 prefix length {num_tokens} for {len(token_ids)} tokens"
+        )
+
+    digest = sha256(_CACHE_KEY_VERSION)
+    digest.update(pack("<I", num_tokens))
+    try:
+        packed_tokens = array("I", token_ids[:num_tokens])
+    except (OverflowError, TypeError) as exc:
+        raise ValueError("Invalid RWKV7 prompt token id") from exc
+    if packed_tokens.itemsize != 4:
+        raise RuntimeError("RWKV7 state-cache keys require 32-bit unsigned integers")
+    if sys.byteorder != "little":
+        packed_tokens.byteswap()
+    digest.update(packed_tokens.tobytes())
+    return digest.digest()
+
+
+def rwkv_state_cache_positions(
+    max_num_tokens: int,
+    block_size: int,
+) -> tuple[int, ...]:
+    """Return reusable recurrent-state boundaries up to ``max_num_tokens``."""
+    if block_size <= 0:
+        raise ValueError("RWKV7 state-cache block size must be positive")
+    if max_num_tokens <= 0:
+        return ()
+
+    return tuple(range(block_size, max_num_tokens + 1, block_size))
+
+
+def is_rwkv_state_cache_position(
+    num_tokens: int,
+    prompt_len: int,
+    block_size: int,
+) -> bool:
+    """Return whether a completed prefill state should be snapshotted."""
+    return 0 < num_tokens < prompt_len and num_tokens % block_size == 0
+
+
+class RWKVStatePrefixCache(Generic[T]):
+    """Small process-local LRU used by RWKV scheduler and worker state caches."""
+
+    def __init__(self, capacity: int) -> None:
+        if capacity <= 0:
+            raise ValueError("RWKV7 state-cache capacity must be positive")
+        self.capacity = capacity
+        self._entries: OrderedDict[bytes, T] = OrderedDict()
+
+    def __len__(self) -> int:
+        return len(self._entries)
+
+    def clear(self) -> None:
+        self._entries.clear()
+
+    def get(self, key: bytes) -> T | None:
+        value = self._entries.get(key)
+        if value is not None:
+            self._entries.move_to_end(key)
+        return value
+
+    def put(self, key: bytes, value: T) -> None:
+        self._entries[key] = value
+        self._entries.move_to_end(key)
+        while len(self._entries) > self.capacity:
+            self._entries.popitem(last=False)
+
+    def find_longest(
+        self,
+        token_ids: Sequence[int],
+        max_num_tokens: int,
+        block_size: int,
+    ) -> tuple[int, T | None]:
+        for num_tokens in reversed(
+            rwkv_state_cache_positions(max_num_tokens, block_size)
+        ):
+            value = self.get(rwkv_state_prefix_key(token_ids, num_tokens))
+            if value is not None:
+                return num_tokens, value
+        return 0, None
