+            additional_config["rwkv_state_prefix_cache"] = (
+                state_prefix_cache_requested
+            )
+            additional_config["rwkv_state_prefix_cache_capacity"] = capacity
+            additional_config["rwkv_state_prefix_cache_block_size"] = block_size
+
         scheduler_config = getattr(vllm_config, "scheduler_config", None)
         if scheduler_config is not None:
             token_budget = scheduler_config.max_num_scheduled_tokens
