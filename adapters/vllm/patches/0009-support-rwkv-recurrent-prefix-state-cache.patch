+            if state_prefix_cache_requested and capacity <= 0:
+                raise ValueError(
+                    "rwkv_state_prefix_cache_capacity must be positive"
+                )
+            if state_prefix_cache_requested and block_size <= 0:
+                raise ValueError(
+                    "rwkv_state_prefix_cache_block_size must be positive"
