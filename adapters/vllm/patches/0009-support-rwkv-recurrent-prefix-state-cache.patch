diff --git a/tests/v1/test_rwkv_state_prefix_cache.py b/tests/v1/test_rwkv_state_prefix_cache.py
new file mode 100644
index 000000000..e0957d8ea
--- /dev/null
+++ b/tests/v1/test_rwkv_state_prefix_cache.py
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.v1.core.sched.scheduler import Scheduler
+from vllm.v1.rwkv_state_prefix_cache import (
+    RWKVStatePrefixCache,
+    is_rwkv_state_cache_position,
+    rwkv_state_cache_positions,
+    rwkv_state_prefix_key,
+)
+
+
+def test_rwkv_state_cache_positions_use_complete_blocks_only():
+    assert rwkv_state_cache_positions(191, 64) == (64, 128)
+    assert rwkv_state_cache_positions(128, 64) == (64, 128)
+    assert rwkv_state_cache_positions(0, 64) == ()
+
+
+def test_rwkv_state_cache_position_requires_complete_recomputable_block():
+    assert is_rwkv_state_cache_position(64, 130, 64)
+    assert not is_rwkv_state_cache_position(129, 130, 64)
+    assert not is_rwkv_state_cache_position(130, 130, 64)
+    assert not is_rwkv_state_cache_position(63, 130, 64)
+
+
+def test_rwkv_state_prefix_key_is_order_and_length_sensitive():
+    tokens = [1, 2, 3, 4]
+    assert rwkv_state_prefix_key(tokens, 3) == rwkv_state_prefix_key(tokens, 3)
+    assert rwkv_state_prefix_key(tokens, 3) != rwkv_state_prefix_key(tokens, 4)
+    assert rwkv_state_prefix_key(tokens, 3) != rwkv_state_prefix_key(
+        [1, 3, 2, 4], 3
+    )
+
+
+def test_rwkv_state_prefix_key_rejects_invalid_inputs():
+    with pytest.raises(ValueError, match="prefix length"):
+        rwkv_state_prefix_key([1, 2], 0)
+    with pytest.raises(ValueError, match="token id"):
+        rwkv_state_prefix_key([1, -1], 2)
+
+
+def test_rwkv_state_prefix_cache_finds_longest_and_evicts_lru():
+    cache = RWKVStatePrefixCache[str](capacity=2)
+    tokens = list(range(10))
+    key4 = rwkv_state_prefix_key(tokens, 4)
+    key8 = rwkv_state_prefix_key(tokens, 8)
+    cache.put(key4, "four")
+    cache.put(key8, "eight")
+
+    assert cache.find_longest(tokens, 9, 4) == (8, "eight")
+    cache.put(rwkv_state_prefix_key([99], 1), "other")
+
+    assert cache.get(key8) == "eight"
+    assert cache.get(key4) is None
+    cache.clear()
+    assert len(cache) == 0
+
+
+def _scheduler_with_rwkv_cache(block_size: int = 4) -> Scheduler:
+    scheduler = object.__new__(Scheduler)
+    scheduler.rwkv_state_prefix_cache = RWKVStatePrefixCache[int](capacity=4)
+    scheduler.rwkv_state_prefix_cache_block_size = block_size
+    return scheduler
+
+
+def _request(tokens: list[int], num_computed_tokens: int = 0) -> SimpleNamespace:
+    return SimpleNamespace(
+        prompt_token_ids=tokens,
+        prompt_embeds=None,
+        lora_request=None,
+        cache_salt=None,
+        skip_reading_prefix_cache=False,
+        num_prompt_tokens=len(tokens),
+        num_computed_tokens=num_computed_tokens,
+    )
+
+
+def test_scheduler_uses_longest_rwkv_state_prefix_hit():
+    scheduler = _scheduler_with_rwkv_cache()
+    request = _request(list(range(10)))
+    assert scheduler.rwkv_state_prefix_cache is not None
+    scheduler.rwkv_state_prefix_cache.put(
+        rwkv_state_prefix_key(request.prompt_token_ids, 4), 4
+    )
+    scheduler.rwkv_state_prefix_cache.put(
+        rwkv_state_prefix_key(request.prompt_token_ids, 8), 8
+    )
+
+    assert scheduler._get_rwkv_state_cache_hit(request) == 8
+
+
+def test_scheduler_rwkv_cache_split_stops_at_snapshot_boundaries():
+    scheduler = _scheduler_with_rwkv_cache()
+    request = _request(list(range(10)))
+
+    assert scheduler._rwkv_state_cache_aligned_split(request, 9) == 4
+    request.num_computed_tokens = 4
+    assert scheduler._rwkv_state_cache_aligned_split(request, 5) == 4
+    request.num_computed_tokens = 8
+    assert scheduler._rwkv_state_cache_aligned_split(request, 2) == 2
+    request.num_computed_tokens = 9
+    assert scheduler._rwkv_state_cache_aligned_split(request, 1) == 1
+
+
+def test_scheduler_registers_completed_output_not_optimistic_future_state():
+    scheduler = _scheduler_with_rwkv_cache()
+    request = _request(list(range(10)), num_computed_tokens=8)
+
+    scheduler._cache_rwkv_state_prefix(request, completed_tokens=4)
+
+    assert scheduler._get_rwkv_state_cache_hit(request) == 4
