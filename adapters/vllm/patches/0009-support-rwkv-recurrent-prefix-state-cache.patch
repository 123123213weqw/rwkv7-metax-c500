+def test_rwkv7_model_state_restores_recurrent_prefix_snapshot():
+    state = _new_rwkv7_model_state(
+        max_num_reqs=2,
+        state_prefix_cache=True,
+        state_prefix_cache_capacity=2,
+        state_prefix_cache_block_size=2,
+    )
+    prompt_token_ids = [11, 12, 13, 14, 15]
+    state.add_request(
+        0,
+        _new_request("cold", prompt_token_ids=prompt_token_ids),
+    )
+    input_batch = _rwkv7_input_batch(
+        state,
+        idx_mapping_np=np.array([0], dtype=np.int32),
+        query_start_loc=torch.tensor([0, 2], dtype=torch.int32),
+        is_prefilling_np=np.array([True], dtype=np.bool_),
+        num_scheduled_tokens=np.array([2], dtype=np.int32),
+        num_computed_prefill_tokens_np=np.array([0], dtype=np.int32),
+        prefill_len_np=np.array([5], dtype=np.int32),
+    )
+
+    inputs = state.prepare_inputs(input_batch, req_states=None)
+    cold_row = state.req_slot_to_row[0]
+    inputs["shift_state"][:, :, cold_row].fill_(3)
+    inputs["wkv_state"][:, cold_row].fill_(5)
+    inputs["elapsed"][cold_row].fill_(2)
+    state.postprocess_state(inputs["idx_mapping"], 0)
+    assert state.state_prefix_cache is not None
+    assert len(state.state_prefix_cache) == 1
+
+    state.remove_request("cold")
+    state.add_request(
+        1,
+        _new_request(
+            "hit",
+            prompt_token_ids=prompt_token_ids,
+            num_computed_tokens=2,
+        ),
+    )
+    hit_row = state.req_slot_to_row[1]
+    assert torch.all(state.shift_state[:, :, hit_row] == 3)
+    assert torch.all(state.wkv_state[:, hit_row] == 5)
+    assert state.elapsed[hit_row].item() == 2
+
+
+def test_rwkv7_model_state_rejects_scheduler_hit_without_worker_snapshot():
+    state = _new_rwkv7_model_state(
+        max_num_reqs=2,
+        state_prefix_cache=True,
+        state_prefix_cache_block_size=2,
+    )
+
+    with pytest.raises(RuntimeError, match="without a matching worker state"):
+        state.add_request(
+            0,
+            _new_request(
+                "missing",
+                prompt_token_ids=[11, 12, 13],
+                num_computed_tokens=2,
+            ),
+        )
+
+
+def test_rwkv7_model_state_does_not_cache_salted_request():
+    state = _new_rwkv7_model_state(
