+def get_cuda_compiler() -> str:
+    override = os.getenv("VLLM_CUDA_COMPILER")
+    candidates = [override]
+    if CUDA_HOME is not None:
+        candidates.extend(
+            [
+                os.path.join(CUDA_HOME, "bin", "nvcc"),
+                os.path.join(CUDA_HOME, "bin", "cucc"),
+            ]
+        )
+    for candidate in candidates:
+        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    raise FileNotFoundError("neither nvcc nor a CUDA-compatible cucc compiler was found")
+
+
+def get_cuda_version_compiler() -> str:
+    override = os.getenv("VLLM_CUDA_VERSION_COMPILER")
+    candidates = [override]
+    maca_path = os.getenv("MACA_PATH")
+    if maca_path:
+        candidates.append(os.path.join(maca_path, "tools", "cu-bridge", "bin", "cucc"))
+    candidates.append(get_cuda_compiler())
+    for candidate in candidates:
+        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+            return candidate
+    raise FileNotFoundError("no CUDA version-reporting compiler was found")
+
+
+def get_cmake_command() -> str:
+    override = os.getenv("VLLM_CMAKE_COMMAND")
+    if override:
+        return override
+    if CUDA_HOME is not None and os.path.isfile(os.path.join(CUDA_HOME, "bin", "cucc")):
+        maca_cmake = which("cmake_maca")
+        if maca_cmake:
+            return maca_cmake
+    return "cmake"
+
+
+CMAKE_COMMAND = get_cmake_command()
+
+
