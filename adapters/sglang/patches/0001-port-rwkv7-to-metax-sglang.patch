diff --git a/python/sglang/srt/speculative/rwkv_chain_worker.py b/python/sglang/srt/speculative/rwkv_chain_worker.py
new file mode 100644
index 0000000000000000000000000000000000000000..b545517c055a12b7c2c7c61df6bb45e5a1d7eec9
