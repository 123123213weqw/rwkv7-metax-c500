diff --git a/python/sglang/_metax_sgl_kernel_stub.py b/python/sglang/_metax_sgl_kernel_stub.py
new file mode 100644
index 0000000000000000000000000000000000000000..f336a9b3d770a379c24af8e88c92ce8e3cff8daf
--- /dev/null
+++ b/python/sglang/_metax_sgl_kernel_stub.py
@@ -0,0 +1,69 @@
+"""Import-only isolation for reduced MetaX builds without sglang-kernel.
+
+The RWKV-7 path does not use SGLang's generic CUDA MoE, FP8, or attention
+operators, but several registry modules import their symbols eagerly.  MetaX
+images do not ship the NVIDIA sglang-kernel wheel.  This stub lets those
+modules import while preserving a hard failure if an unavailable operator is
+actually called.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+import types
+
+
+_SUBMODULES = (
+    "allreduce",
+    "elementwise",
+    "flash_attn",
+    "flash_mla",
+    "kvcacheio",
+    "mamba",
+    "quantization",
+    "sparse_flash_attn",
+    "speculative",
+    "test_utils",
+)
+
+
+def _unavailable(*args, **kwargs):
+    del args, kwargs
+    raise RuntimeError(
+        "This SGLang operator requires a native MetaX sglang-kernel build; "
+        "it is outside the reduced RWKV-7 execution path."
+    )
+
+
+def _module(name: str) -> types.ModuleType:
+    module = types.ModuleType(name)
+    module.__file__ = __file__
+
+    def _getattr(attr: str):
+        if attr.startswith("__"):
+            raise AttributeError(attr)
+        return _unavailable
+
+    module.__getattr__ = _getattr
+    return module
+
+
+def install() -> None:
+    if importlib.util.find_spec("sgl_kernel") is not None:
+        return
+
+    import torch
+
+    if getattr(torch.version, "maca", None) is None:
+        return
+
+    root = _module("sgl_kernel")
+    root.__path__ = []
+    root.__sglang_import_only_stub__ = True
+    sys.modules["sgl_kernel"] = root
+    for child in _SUBMODULES:
+        full_name = f"sgl_kernel.{child}"
+        child_module = _module(full_name)
+        sys.modules[full_name] = child_module
+        setattr(root, child, child_module)
